# Optional canonical origin for Vercel. Defaults to https://saaim.site.
NEXT_PUBLIC_SITE_URL=https://saaim.site

# Leave empty on Vercel. GitHub Actions supplies these for Pages automatically.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_STATIC_EXPORT=false

# Optional ownership verification tokens (the content value, not a full meta tag).
# Add in Vercel's Production environment and redeploy. DNS verification also works.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Vercel production is indexable by default. Pages exports default to a noindex
# mirror to keep saaim.site primary. Set this only if Pages becomes the main site:
# NEXT_PUBLIC_SEARCH_INDEXING=true
