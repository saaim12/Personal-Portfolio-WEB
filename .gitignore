# ── Dependencies ──────────────────────────────────────────────
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/releases

# ── Build output (Next.js, static export, tooling caches) ─────
/.next/
/out/
/build/
/dist/
/.turbo/
/.swc/
next-env.d.ts
*.tsbuildinfo
.eslintcache

# ── Secrets and deployment state (never commit keys) ──────────
.env
.env.*
!.env.example
*.pem
*.key
/.vercel/

# ── Local documentation (kept out of the repository) ─────────
/docs/

# ── Tests, audits and reports ─────────────────────────────────
/coverage/
/playwright-report/
/test-results/
/blob-report/
/.lighthouseci/
/.audit*/
/.audit-log.txt
/.indexnow-state/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Scratch and transfer files ────────────────────────────────
/tmp/
/scratch/
/*.local.*
/sync*.tar
/sync*-files.txt

# ── Operating systems ─────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editors (keep shared VS Code settings) ────────────────────
/.idea/
*.swp
*.swo
*~
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json
